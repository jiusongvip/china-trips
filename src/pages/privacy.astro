 ---
 import BaseLayout from "../layouts/BaseLayout.astro";

 const pageTitle = "Privacy Policy — China Trips Travel Guide";
 const pageDesc = "Privacy policy for China Trips. We use Google Analytics for anonymous aggregate statistics. No ad pixels, no personal data collection, no data selling. Simple.";
 ---

 <BaseLayout title={pageTitle} description={pageDesc} ogImage="/images/hero/og-default.webp">
   <nav class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-[var(--color-border)]">
     <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
       <a href="/" class="text-lg font-semibold tracking-tight text-[var(--color-text)] no-underline">China Trips</a>
       <a href="/" class="text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors no-underline">← Back to Guide</a>
     </div>
   </nav>

   <main class="section">
     <div class="container max-w-3xl">
       <span class="section-eyebrow">Legal</span>
       <h1 class="heading-lg text-4xl md:text-5xl text-[var(--color-text)] mb-6">Privacy Policy</h1>
       <p class="body-text text-sm mb-6">Last updated: August 19, 2026</p>

       <div class="card p-6 space-y-5">
         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">What We Collect</h2>
           <p class="body-text text-sm">The Trip Planner form on our homepage asks for your trip duration and travel style. These are <strong>not stored on any server</strong> — they are processed entirely in your browser to generate personalized trip suggestions. We do not collect names, email addresses, or personal identifiers through this tool. We use Google Analytics to understand which pages are most useful; it collects anonymous, aggregated data (pages visited, approximate region, device type) and does not identify individual visitors.</p>
         </div>

         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">Cookies & Tracking</h2>
           <p class="body-text text-sm">We use <strong>Google Analytics</strong> to understand how visitors use our site. It sets cookies that collect anonymous, aggregated usage data. We use <strong>no</strong> advertising pixels, no Facebook Pixel, no retargeting, and no cross-site tracking. We do not sell or share your data with advertisers.</p>
         </div>

         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">Data Sharing</h2>
           <p class="body-text text-sm">We do <strong>not</strong> sell, rent, or share any visitor data with third parties. We run no ads and use no external ad networks. Anonymous, aggregated analytics data is processed by Google solely to provide us with usage statistics.</p>
         </div>

         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">Email</h2>
           <p class="body-text text-sm">If you contact us at <a href="mailto:hello@chinatripzone.com" class="text-[var(--color-accent)] hover:underline">hello@chinatripzone.com</a>, we will only use your email address to respond to your inquiry. We do not add you to any mailing list.</p>
         </div>

         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">Hosting</h2>
           <p class="body-text text-sm">China Trips is hosted on a static hosting provider. Standard server logs (IP address, timestamp, requested URL) may be collected by our hosting provider for operational purposes. These logs are not accessible to us for visitor tracking.</p>
         </div>

         <div>
           <h2 class="heading-md text-lg text-[var(--color-text)] mb-2">Contact</h2>
           <p class="body-text text-sm">Questions about this policy? Email us at <a href="mailto:hello@chinatripzone.com" class="text-[var(--color-accent)] hover:underline">hello@chinatripzone.com</a>.</p>
         </div>
       </div>
     </div>
   </main>

   <footer class="border-t border-[var(--color-border)] py-8">
     <div class="container text-center">
       <p class="text-xs text-[var(--color-text-muted)]">&copy; 2026 China Trips · <a href="/about/" class="hover:text-[var(--color-text)] transition-colors">About</a> · <a href="/privacy/" class="hover:text-[var(--color-text)] transition-colors">Privacy</a> · <a href="/" class="hover:text-[var(--color-text)] transition-colors">Home</a></p>
     </div>
   </footer>
 </BaseLayout>
