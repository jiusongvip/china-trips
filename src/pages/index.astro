      const bestMonths = { "7": "Spring (Apr-May) or Autumn (Sep-Oct)", "10": "April-May / September-October", "14": "April-May / Sept-November", "21": "Sept-Oct ideal. Yunnan winter is mild." };
      const cities = cityRoutes[days]?.[who] || ["Beijing", "Shanghai"];
