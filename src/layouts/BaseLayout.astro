---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object;
  preloadImage?: string;
  noCanonical?: boolean;
}
const { title, description, ogImage, schema, preloadImage, noCanonical } = Astro.props;
const rawCanonical = new URL(Astro.url.pathname, Astro.site).href;
const canonicalURL = rawCanonical.length > 1 && rawCanonical.endsWith("/") ? rawCanonical.slice(0, -1) : rawCanonical;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "China Trips",
  "url": "https://china-trips.com",
  "description": "Independent travel guide for China — detailed itineraries, real budgets, honest city guides, and practical advice.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://china-trips.com/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "China Trips",
  "url": "https://china-trips.com",
  "logo": "https://china-trips.com/favicon.svg",
  "description": "Independent travel guide for China — detailed itineraries, real budgets, honest city guides, and practical advice."
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content="website" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- WebSite + Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>